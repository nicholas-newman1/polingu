rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Audio folder rules - pending uploads
    match /audio/users/{userId}/pending/{audioId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('audio/.*')
                       || fileName.matches('.*\\.(mp3|wav|ogg|flac|m4a)$'));
      allow read: if false;
    }
    
    // Audio folder rules - processed audio
    match /audio/users/{userId}/{audioId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // System audio - any authenticated user can read
    match /audio/system/{audioId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Books folder rules - pending uploads
    match /books/users/{userId}/pending/{bookId}/{fileName} {
      // Authenticated user can upload to their pending folder
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType == 'application/epub+zip'
                       || fileName.matches('.*\\.(pdf|epub)$'));
      // No direct reads from pending - Cloud Function processes these
      allow read: if false;
    }
    
    // Books folder rules - processed books
    match /books/users/{userId}/{bookId}/{fileName} {
      // Only owner can read from final location
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only Cloud Functions can write here (no client writes)
      allow write: if false;
    }
  }
}
