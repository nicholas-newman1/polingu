        "maxCognitive": 40,
        "reason": "Interactive views wiring several hooks (refs, effects, context reads); with hook density excluded each scores under the 25 component ceiling, and splitting would only move hooks into prop-drilled children."
      }
    ]
  },
  "duplicates": {
    "ignore": ["src/data/**"]
  }
}
