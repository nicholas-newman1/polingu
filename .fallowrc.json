{
  "entry": ["functions/src/index.ts"],
  "ignoreDependencies": ["@emotion/react", "@emotion/styled"],
  "health": {
    "maxCrap": 0,
    "thresholdOverrides": [
      {
        "files": ["src/pages/**/*.tsx", "src/components/**/*.tsx"],
        "maxCognitive": 25,
        "reason": "Conditional JSX and inline event callbacks inflate cognitive complexity for page and modal components; cyclomatic stays at the default ceiling."
      },
      {
        "files": ["src/hooks/useReviewSession.ts"],
        "functions": ["useReviewSession"],
        "maxCognitive": 20,
        "reason": "Composer hook; the score comes from nesting inside small closures rather than branching."
      },
      {
        "files": [
          "src/contexts/AudioPlayerContext.tsx",
          "src/contexts/ListeningContext.tsx",
          "src/contexts/TranslatableTextContext.tsx",
          "src/contexts/review/SentenceContext.tsx",
          "src/hooks/useQueueManager.ts"
        ],
        "functions": [
          "AudioPlayerProvider",
          "ListeningProvider",
          "TranslatableTextProvider",
          "SentenceProvider",
          "useQueueManager"
        ],
        "maxCognitive": 60,
        "reason": "Context providers and the queue hook are flat lists of useState/useCallback/useMemo; nearly the whole score is fallow's +1-per-hook density penalty (branching contributes under 5)."
      },
      {
        "files": [
          "src/components/TranslatableWord.tsx",
          "src/components/TranslatableText.tsx",
          "src/pages/AudioPlayerPage/index.tsx",
