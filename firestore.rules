rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User settings - only the owner can read/write
    match /users/{userId}/data/settings {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User filters (conjugation, declension, etc.) - only the owner can read/write
    match /users/{userId}/data/userFilters {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy declension review data document (kept readable/writable so the
    // app can finish draining IndexedDB pending writes and the migration
    // script can delete it). Safe to remove once all users have migrated.
    match /users/{userId}/data/reviewData {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Declension per-card review data (one doc per card)
    match /users/{userId}/declensionReviewCards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Declension per-day session counters (reviewedToday, newCardsToday, lastReviewDate)
    match /users/{userId}/data/declensionReviewSession {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy vocabulary review data documents (kept until migration drains)
    match /users/{userId}/data/vocabularyReviewData-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/vocabularyReviewData-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vocabulary per-card review data (one doc per word, per direction)
    match /users/{userId}/vocabularyReviewCards-pl-en/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/vocabularyReviewCards-en-pl/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vocabulary per-day session counters
    match /users/{userId}/data/vocabularyReviewSession-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/vocabularyReviewSession-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User vocabulary settings (per direction) - only the owner can read/write
    match /users/{userId}/data/vocabularySettings-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/vocabularySettings-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy sentence review data documents (kept until migration drains)
    match /users/{userId}/data/sentenceReviewData-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/sentenceReviewData-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sentence per-card review data (one doc per sentence, per direction)
    match /users/{userId}/sentenceReviewCards-pl-en/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sentenceReviewCards-en-pl/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sentence per-day session counters
    match /users/{userId}/data/sentenceReviewSession-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/sentenceReviewSession-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User sentence settings (per direction) - only the owner can read/write
    match /users/{userId}/data/sentenceSettings-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/sentenceSettings-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy conjugation review data documents (kept until migration drains)
    match /users/{userId}/data/conjugationReviewData-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/conjugationReviewData-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Conjugation per-form review data (one doc per form, per direction)
    match /users/{userId}/conjugationReviewForms-pl-en/{formKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/conjugationReviewForms-en-pl/{formKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Conjugation per-day session counters
    match /users/{userId}/data/conjugationReviewSession-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/conjugationReviewSession-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User conjugation settings (per direction) - only the owner can read/write
    match /users/{userId}/data/conjugationSettings-pl-en {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/data/conjugationSettings-en-pl {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy aspect pairs review data document (kept until migration drains)
    match /users/{userId}/data/aspectPairsReviewData {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Aspect pairs per-card review data (one doc per pair)
    match /users/{userId}/aspectPairsReviewCards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Aspect pairs per-day session counters
    match /users/{userId}/data/aspectPairsReviewSession {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User aspect pairs settings - only the owner can read/write
    match /users/{userId}/data/aspectPairsSettings {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User app settings - only the owner can read/write
    match /users/{userId}/data/appSettings {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reader settings - only the owner can read/write
    match /users/{userId}/data/reader-settings {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Listening settings - only the owner can read/write
    match /users/{userId}/data/listeningSettings {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Listening hub selections - only the owner can read/write
    match /users/{userId}/data/listeningHubSelections {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reader progress, highlights, bookmarks - only the owner can read/write
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId
                         && docId.matches('reader-.*');
    }

    // Custom cards (per-card subcollections, new model) - only the owner can read/write
    match /users/{userId}/customSentences/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/customVocabulary/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/customDeclension/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Audio queue - only the owner can read/write
    match /users/{userId}/audioQueue/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Audio items - owner can read and update title, Cloud Function creates/deletes
    match /users/{userId}/audioItems/{audioId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['title']);
      allow create, delete: if false;
    }

    // Books - owner can read and update, Cloud Function creates/deletes
    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['title', 'author', 'color']);
      allow create, delete: if false;
    }

    // Book chapters - owner can read, Cloud Function writes
    match /users/{userId}/books/{bookId}/chapters/{chapterId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // User rate limits - users can only read their own (writes done by Cloud Function)
    match /userRateLimits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Sentences - public read, admin write
    match /sentences/{sentenceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Vocabulary - public read, admin write
    match /vocabulary/{wordId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Declension cards - public read, admin write
    match /declensionCards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Verbs - public read, admin write
    match /verbs/{verbId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Sentence tags config - public read, admin write
    match /config/sentenceTags {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Kill switch - public read so clients can gracefully degrade; writes are
    // restricted to the kill-switch Cloud Function service account and admins.
    match /config/killSwitch {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // System audio items - public read, admin write
    match /systemAudioItems/{audioId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}

